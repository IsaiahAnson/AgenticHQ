artifacts/*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*.html
artifacts/*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*.json
artifacts/*-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*.html
artifacts/*-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*.json
