{
  "skills": [
    {
      "id": "release-notes",
      "agent": "claude",
      "icon": "doc",
      "model": 2,
      "effort": 1,
      "prompt": "Draft release notes for the current project from PRs merged since the last tag. Group by feature, fix and docs. Use PR titles, link each PR, and keep each line under 90 characters. Save the draft to the ring; don't publish.",
      "context": true
    },
    {
      "id": "triage",
      "agent": "claude",
      "icon": "mail",
      "model": 2,
      "effort": 1,
      "prompt": "Go through new issues and beta-tester mail. Label each one (bug, question, idea), find duplicates, and draft a short reply for anything that needs one. Never send; leave drafts for review.",
      "context": true
    },
    {
      "id": "pr-review",
      "agent": "claude",
      "icon": "eye",
      "model": 2,
      "effort": 2,
      "prompt": "Review the open PR on this branch. Check tests, risky diffs, naming and docs. Leave a short summary with blocking issues first, then nits. Note anything that needs a follow-up issue.",
      "context": true
    },
    {
      "id": "dep-watch",
      "agent": "codex",
      "icon": "box",
      "model": 2,
      "effort": 1,
      "prompt": "Check orbit-notes, tidepool, paper-lantern and fieldkit for outdated dependencies and advisories. Read each lockfile diff, flag new transitive packages, and list safe bumps first.",
      "context": true
    },
    {
      "id": "weekly-review",
      "agent": "claude",
      "icon": "chart",
      "model": 2,
      "effort": 1,
      "prompt": "Write the week in HQ: routine runs, failures, lessons added, ring pages, radar picks. End with three focus items for next week. Keep it to one screen.",
      "context": true
    },
    {
      "id": "test-fixer",
      "agent": "claude",
      "icon": "flask",
      "model": 2,
      "effort": 2,
      "prompt": "Find the failing or flaky test named in the prompt. Reproduce it, fix the cause rather than the symptom, and quarantine it with an issue if it fails twice for reasons outside the code.",
      "context": true
    },
    {
      "id": "design-critique",
      "agent": "claude",
      "icon": "pen",
      "model": 2,
      "effort": 1,
      "prompt": "Critique the screen or screenshot given: hierarchy, spacing, contrast in both themes, empty states and copy. Rank the five fixes that matter most and show where each one goes.",
      "context": true
    },
    {
      "id": "standup",
      "agent": "claude",
      "icon": "clock",
      "model": 2,
      "effort": 1,
      "prompt": "Draft today's standup from yesterday's commits and merged PRs across the four projects. Three bullets per project at most: done, doing, blocked.",
      "context": true
    },
    {
      "id": "brain-refresh",
      "agent": "claude",
      "icon": "brain",
      "model": 2,
      "effort": 1,
      "prompt": "Rebuild the Second Brain map from the workspace folder. Skip the rebuild when no file changed since the last run, and report what moved.",
      "context": true
    },
    {
      "id": "ship",
      "agent": "claude",
      "icon": "send",
      "model": 2,
      "effort": 2,
      "prompt": "Take the spec named in the prompt from plan to merged branch: own worktree, tests first, small commits, and a short report on the ring. Stop and ask before any migration.",
      "context": true
    }
  ],
